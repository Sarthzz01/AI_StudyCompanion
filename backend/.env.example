# Database connection URL (PostgreSQL default; falls back to local SQLite if unreachable)
DATABASE_URL=sqlite:///./ai_study_companion.db

# JWT secret key used for signing authentication tokens
JWT_SECRET=your-secure-jwt-secret-key-change-in-production

# Google Gemini API key (server-side only; leave empty if not using live AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API key (server-side only; used for AI Tutor responses)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Frontend URL (used for password reset links)
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (Optional: if blank, reset links are printed to server console in dev mode)
# For Gmail, use an App Password (not your normal Google password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM_EMAIL=noreply@aistudycompanion.com
# SMTP_FROM_NAME="AI Study Companion"
# SMTP_USE_TLS=true

